# Copy this file to .env (used by the Prisma CLI) and .env.local (used by
# Next.js) and fill in real values. Never commit the filled-in files —
# .env* is already gitignored.

# Neon Postgres connection string.
DATABASE_URL=

# Shared passcode gating the whole app (there are no user accounts).
APP_PASSCODE=

# Shared secret for the /api/cron/tick pinger (cron-job.org). Generate with:
#   openssl rand -hex 32
CRON_SECRET=

# Web Push VAPID keypair. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Must match VAPID_PUBLIC_KEY — exposed to the browser to subscribe to push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
