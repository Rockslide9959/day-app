generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- End-of-day "unfinished to-dos" reminder ---
  // Device-agnostic (unlike theme/icon style, which are localStorage-only)
  // since the cron tick that fires it runs server-side with no device to
  // ask — settings page writes these, and captures the browser's IANA zone
  // into todoReminderTimeZone whenever the time is changed so the "HH:MM"
  // resolves to the right UTC instant. See lib/todoReminderCron.ts.
  todoReminderEnabled      Boolean @default(true)
  todoReminderTime         String  @default("20:00")
  todoReminderTimeZone     String?
  // "YYYY-MM-DD" local date (in todoReminderTimeZone) this user was last
  // checked for the day — dedupes repeated cron ticks the same evening
  // without needing a separate delivery-log table like schedule reminders.
  todoReminderLastSentDate String?
  // "YYYY-MM-DD" local date (in todoReminderTimeZone) unfinished to-dos were
  // last rolled forward for this user — same dedupe shape as
  // todoReminderLastSentDate, but for lib/todoRolloverCron.ts. Independent
  // of todoReminderEnabled: rollover isn't a notification, so it always runs.
  todoRolloverLastDate String?

  reminders         Reminder[]
  scheduleItems     ScheduleItem[]
  todos             Todo[]
  routines          Routine[]
  eventCategories   EventCategory[]
  pushSubscriptions PushSubscription[]
  timers            Timer[]
  eventShares       EventShare[]
  notebookEntries   NotebookEntry[]
  attachments       Attachment[]
}

model Reminder {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  notes      String?
  dueAt      DateTime
  // "none" | "daily" | "weekly" | "weekdays"
  recurrence String   @default("none")
  notified   Boolean  @default(false)
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dueAt])
  @@index([userId])
}

model ScheduleItem {
  id                    String  @id @default(cuid())
  userId                String
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  notes                 String?
  // "event" | "task" — a task's `date` is its due date, and `startTime`/
  // `endTime` are its due time (or "00:00"/"23:59" with allDay:true when
  // no due time is set). Tasks never span a range: endDate == date.
  itemType              String  @default("event")
  // ISO date, e.g. "2026-08-12"
  date                  String
  startTime             String
  endTime               String
  // Multi-day support; defaults to `date` when absent (same-day event)
  endDate               String?
  allDay                Boolean @default(false)
  location              String?
  // Free-form category name — one of the app's defaults or a custom
  // EventCategory.name the user created in Settings.
  category              String?
  reminderMinutesBefore Int?
  // "low" | "normal" | "high" | "urgent"
  priority              String  @default("normal")

  // --- Recurrence ---
  // "none" | "daily" | "weekly" | "monthly" | "weekdays" | "custom"
  recurrence        String  @default("none")
  // Comma-joined weekday numbers (0=Sun..6=Sat), used by "weekly"/"custom"
  // (e.g. Mon/Wed/Fri gym = "1,3,5"). Null for other recurrence types.
  recurrenceDays    String?
  // Optional bound on how far the series repeats; open-ended if null
  // (expansion is still bounded by whatever range is being queried).
  recurrenceEndDate String?

  // --- Completion ---
  // Non-recurring events: whether it's done.
  completed      Boolean   @default(false)
  // When `completed` last became true; cleared when reopened. Informational
  // only — the task visibility rule (lib/calendar/visibility.ts) is based
  // on `completed` + the due date/time, not this field.
  completedAt    DateTime?
  // Recurring events: per-occurrence completion, comma-joined "YYYY-MM-DD"
  // (same convention as RoutineRun.completedStepIds elsewhere in this app).
  completedDates String    @default("")

  // --- Study features (Assignment/Test/Exam categories) ---
  subject        String?
  estimatedHours Float?

  // IANA zone (e.g. "Africa/Johannesburg") the item's date/startTime/endTime
  // are local to — captured from the browser at creation time. Null for
  // rows created before this field existed; lib/timezone.ts#resolveTimeZone
  // falls back to Africa/Johannesburg for those.
  timeZone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares             EventShare[]
  reminderDeliveries ScheduleReminderDelivery[]

  @@index([date])
  @@index([userId])
}

// One row per (occurrence, device) a reminder push either was or should be
// attempted for — see lib/calendar/reminderCron.ts. The unique constraint
// below is the duplicate-prevention mechanism: upserting against it is
// naturally idempotent across repeated/concurrent cron ticks, and keying by
// device (pushEndpoint) rather than a subscription FK means one device's
// success never blocks another's retry, and a later-pruned subscription
// doesn't orphan the row.
model ScheduleReminderDelivery {
  id             String       @id @default(cuid())
  scheduleItemId String
  scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  // "YYYY-MM-DD" — which occurrence (of a recurring item) this covers.
  occurrenceDate String
  // Calculated UTC instant the reminder was due.
  reminderAt     DateTime
  // PushSubscription.endpoint — not an FK, since a subscription can be
  // deleted/recreated independently of this delivery history.
  pushEndpoint   String
  // "pending" | "sending" | "sent" | "failed". "sending" is a short-lived
  // optimistic-lock state claimed just before a send attempt, guarding
  // against two overlapping cron ticks both delivering the same row.
  status         String       @default("pending")
  attempts       Int          @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([scheduleItemId, occurrenceDate, pushEndpoint])
  @@index([scheduleItemId, occurrenceDate])
  @@index([status, reminderAt])
}

// A shareable link for a ScheduleItem: whoever holds the token can
// preview the event and, once logged in, add their own independent
// copy of it to their calendar. Not a live/synced link — see
// /api/invites/[token] for the accept-as-copy behavior. Cascades with
// the event, so deleting it revokes every link pointing at it.
model EventShare {
  id              String       @id @default(cuid())
  scheduleItemId  String
  scheduleItem    ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  token           String       @unique
  createdAt       DateTime     @default(now())

  @@index([scheduleItemId])
  @@index([createdByUserId])
}

// A user-defined event category, layered on top of the app's built-in
// defaults (which aren't stored as rows — see lib/calendar/categories.ts).
// Unique per-user so two accounts can each have their own "Side Project".
model EventCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  colorHex  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model Todo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  date      String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([userId])
}

model Routine {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String        @default("✅")
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  steps     RoutineStep[]
  runs      RoutineRun[]

  @@index([userId])
}

model RoutineStep {
  id        String   @id @default(cuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([routineId])
}

model RoutineRun {
  id               String   @id @default(cuid())
  routineId        String
  routine          Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  date             String
  // comma-joined RoutineStep ids
  completedStepIds String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([routineId, date])
}

// A stopwatch, countdown, or pomodoro/focus timer, optionally attached
// to a ScheduleItem or Todo. `linkedType`/`linkedId` are a loose
// reference (not a real FK) since they can point at either model.
model Timer {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label              String
  // "stopwatch" | "countdown" | "pomodoro"
  mode               String
  // Target duration in seconds — set for countdown timers, null otherwise.
  durationSeconds    Int?
  // Pomodoro work/break interval lengths in seconds — null for other modes.
  workSeconds        Int?
  breakSeconds       Int?
  // Which pomodoro interval is currently active — "work" | "break".
  // Null for other modes.
  phase              String?
  // Completed work intervals, for a pomodoro's round counter. Unused by
  // other modes.
  cyclesCompleted    Int       @default(0)
  // Seconds banked from prior run segments — accrued while paused, or
  // (for a pomodoro) from phases already finished.
  accumulatedSeconds Int       @default(0)
  // When the current run segment began; null while paused/completed.
  startedAt          DateTime?
  // "running" | "paused" | "completed"
  status             String    @default("running")
  // "schedule" | "todo", paired with linkedId — null for standalone timers.
  linkedType         String?
  linkedId           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([linkedType, linkedId])
}

// A journal entry (tied to a local calendar date) or a general note
// (journalDate: null). Postgres treats each NULL in a unique index as
// distinct from every other NULL, so @@unique([userId, journalDate]) only
// ever collides for two *dated* rows sharing the same user+date — any
// number of undated notes (journalDate: null) coexist freely. That's
// exactly the "max one journal entry per day, unlimited notes" rule this
// model needs, with no extra partial-index migration required.
model NotebookEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  // Always the plain-text representation — searchable, used for previews,
  // and kept in sync with richContent (server-derived, never trusted
  // as-is from the client) whenever contentFormat is "tiptap-json".
  content       String  @default("")
  // "plain" | "tiptap-json" — existing rows default to "plain" with
  // richContent left null; an entry only gains richContent once the user
  // edits it through the rich-text editor and that edit is saved.
  contentFormat String  @default("plain")
  // Validated Tiptap JSON document (see lib/richText.ts). Null whenever
  // contentFormat is "plain". Json maps to a native Postgres `jsonb`
  // column — no special handling needed for this datasource.
  richContent   Json?
  entryType     String  @default("note") // "note" | "journal"
  journalDate   String?
  tags          String  @default("")
  pinned        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, journalDate])
  @@index([userId])
  @@index([userId, updatedAt])
  @@index([userId, entryType])
  @@index([userId, journalDate])
}

// A file attached to a ScheduleItem (event/task) or Todo. `linkedType`/
// `linkedId` are a loose reference (not a real FK), same convention as
// Timer.linkedType/linkedId above, since they can point at either model.
// File bytes live directly in Postgres (no external storage is configured
// for this app) — kept small by MAX_ATTACHMENT_BYTES in lib/attachments.ts.
model Attachment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "todo" | "schedule"
  linkedType String
  linkedId   String
  fileName   String
  mimeType   String
  fileSize   Int
  data       Bytes
  createdAt  DateTime @default(now())

  @@index([linkedType, linkedId])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
