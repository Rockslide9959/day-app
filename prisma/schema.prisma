generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reminders         Reminder[]
  scheduleItems     ScheduleItem[]
  todos             Todo[]
  routines          Routine[]
  eventCategories   EventCategory[]
  pushSubscriptions PushSubscription[]
  timers            Timer[]
}

model Reminder {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  notes      String?
  dueAt      DateTime
  // "none" | "daily" | "weekly" | "weekdays"
  recurrence String   @default("none")
  notified   Boolean  @default(false)
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dueAt])
  @@index([userId])
}

model ScheduleItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  // ISO date, e.g. "2026-08-12"
  date      String
  startTime String
  endTime   String
  // Multi-day support; defaults to `date` when absent (same-day event)
  endDate   String?
  allDay    Boolean  @default(false)
  location  String?
  // Free-form category name — one of the app's defaults or a custom
  // EventCategory.name the user created in Settings.
  category  String?
  reminderMinutesBefore Int?
  // "low" | "normal" | "high" | "urgent"
  priority  String   @default("normal")

  // --- Recurrence ---
  // "none" | "daily" | "weekly" | "monthly" | "weekdays" | "custom"
  recurrence         String    @default("none")
  // Comma-joined weekday numbers (0=Sun..6=Sat), used by "weekly"/"custom"
  // (e.g. Mon/Wed/Fri gym = "1,3,5"). Null for other recurrence types.
  recurrenceDays      String?
  // Optional bound on how far the series repeats; open-ended if null
  // (expansion is still bounded by whatever range is being queried).
  recurrenceEndDate  String?

  // --- Completion ---
  // Non-recurring events: whether it's done.
  completed      Boolean @default(false)
  // Recurring events: per-occurrence completion, comma-joined "YYYY-MM-DD"
  // (same convention as RoutineRun.completedStepIds elsewhere in this app).
  completedDates String  @default("")

  // --- Study features (Assignment/Test/Exam categories) ---
  subject        String?
  estimatedHours Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([userId])
}

// A user-defined event category, layered on top of the app's built-in
// defaults (which aren't stored as rows — see lib/calendar/categories.ts).
// Unique per-user so two accounts can each have their own "Side Project".
model EventCategory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  colorHex  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model Todo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  date      String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([userId])
}

model Routine {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String        @default("✅")
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  steps     RoutineStep[]
  runs      RoutineRun[]

  @@index([userId])
}

model RoutineStep {
  id        String   @id @default(cuid())
  routineId String
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([routineId])
}

model RoutineRun {
  id                 String   @id @default(cuid())
  routineId          String
  routine            Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  date               String
  // comma-joined RoutineStep ids
  completedStepIds   String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([routineId, date])
}

// A stopwatch, countdown, or pomodoro/focus timer, optionally attached
// to a ScheduleItem or Todo. `linkedType`/`linkedId` are a loose
// reference (not a real FK) since they can point at either model.
model Timer {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label  String
  // "stopwatch" | "countdown" | "pomodoro"
  mode   String
  // Target duration in seconds — set for countdown timers, null otherwise.
  durationSeconds Int?
  // Pomodoro work/break interval lengths in seconds — null for other modes.
  workSeconds  Int?
  breakSeconds Int?
  // Which pomodoro interval is currently active — "work" | "break".
  // Null for other modes.
  phase String?
  // Completed work intervals, for a pomodoro's round counter. Unused by
  // other modes.
  cyclesCompleted Int @default(0)
  // Seconds banked from prior run segments — accrued while paused, or
  // (for a pomodoro) from phases already finished.
  accumulatedSeconds Int @default(0)
  // When the current run segment began; null while paused/completed.
  startedAt DateTime?
  // "running" | "paused" | "completed"
  status String @default("running")
  // "schedule" | "todo", paired with linkedId — null for standalone timers.
  linkedType String?
  linkedId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([linkedType, linkedId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
